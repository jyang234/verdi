+// spikeGitLog is a THROWAWAY recorder for docs/spikes/ritual-write-scope
+// (oq-1). Never committed: reverted from the tree before every spike
+// commit (VL-016 fence). Appends one tab-separated line per git
+// invocation to the file named by VERDI_SPIKE_GITLOG, when set; a no-op
+// otherwise so production behavior is unchanged when the env var is
+// absent.
+func spikeGitLog(dir string, args []string) {
+	path := os.Getenv("VERDI_SPIKE_GITLOG")
+	if path == "" {
+		return
+	}
+	who := filepath.Base(os.Args[0])
+	if len(os.Args) > 1 {
+		who += " " + os.Args[1]
+	}
+	if len(os.Args) > 2 {
+		who += " " + os.Args[2]
+	}
+	line := who + "\t" + dir + "\t" + strings.Join(args, " ") + "\n"
+	f, err := os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
+	if err != nil {
+		return
+	}
+	defer f.Close()
+	_, _ = f.WriteString(line)
+}
+
 // run execs `git <args...>` with its working directory set to dir, returning
 // stdout on success. A non-zero exit becomes an error naming the command and
 // stderr, never a silent empty result.
 func run(ctx context.Context, dir string, args ...string) ([]byte, error) {
+	spikeGitLog(dir, args)
 	cmd := exec.CommandContext(ctx, "git", args...)
 	cmd.Dir = dir
 
