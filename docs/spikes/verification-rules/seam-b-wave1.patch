+package readinessload
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+)
+
+// TestClauseWitnessCoverage is spike/verification-rules oq-2 Seam B
+// evidence, REVISION per lane-verification-rules-review.md VR-2
+// (docs/spikes/verification-rules/, THROWAWAY — this whole checkout is a
+// /tmp clone detached at e963f4d0 on agent/readiness-recovery-wave-1;
+// nothing here is ever committed to any real branch). It collects every
+// `// verdi:clause <ref>` marker under internal/ and reports, for
+// readiness-recovery co-2's nine prohibitions (c1..c9), which have a
+// marked witness in the REAL wave-1 codebase.
+func TestClauseWitnessCoverage(t *testing.T) {
+	markerRe := regexp.MustCompile(`verdi:clause (\S+)`)
+	found := map[string]bool{}
+	err := filepath.Walk("..", func(path string, info os.FileInfo, walkErr error) error {
+		if walkErr != nil || info.IsDir() || !strings.HasSuffix(path, "_test.go") {
+			return nil
+		}
+		data, rerr := os.ReadFile(path)
+		if rerr != nil {
+			return rerr
+		}
+		for _, m := range markerRe.FindAllStringSubmatch(string(data), -1) {
+			found[m[1]] = true
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("walking internal/ for clause markers: %v", err)
+	}
+	for i := 1; i <= 9; i++ {
+		ref := fmt.Sprintf("spec/readiness-recovery#co-2/c%d", i)
+		if found[ref] {
+			t.Logf("WITNESSED: %s", ref)
+		} else {
+			t.Errorf("MISSING WITNESS: %s", ref)
+		}
+	}
+}
