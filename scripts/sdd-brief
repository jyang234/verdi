#!/usr/bin/env bash
# sdd-brief — the brief is the whole contract.
#
# Process-audit PA-019 / remedy 6.4: a task brief generated from an
# implementation plan carried only the task's own text; the plan's Global
# Constraints — which bind every task — travelled in the controller's chat
# dispatch, were never persisted, and were never compared against the brief.
# This script writes a brief that carries the plan's binding sections
# VERBATIM ahead of the task text, and can check that existing briefs do.
# The reviewer reads the same file. Nothing binding travels in a message.
#
# Usage:
#   sdd-brief PLAN_FILE TASK_NUMBER OUTFILE
#       write OUTFILE: the plan's "## Global Constraints" (required),
#       "## Rulings recorded in this plan" and "## Amendments during
#       execution" (each when present) verbatim, then "### Task N" text.
#   sdd-brief --check PLAN_FILE BRIEF_FILE...
#       exit 1 naming every brief whose copy of those sections is not
#       byte-identical to the plan's current text (a plan amended after the
#       brief was written fails the check: regenerate the brief).
#
# Section extraction: from a "## <title>" heading up to (not including) the
# next "## " heading, ignoring fenced code blocks. Task extraction: from a
# heading matching "Task N" up to the next same-or-higher heading, the same
# rule superpowers' task-brief script uses.
set -euo pipefail

BINDING_REQUIRED="Global Constraints"
BINDING_OPTIONAL=("Rulings recorded in this plan" "Amendments during execution")

usage() {
  echo "usage: sdd-brief PLAN_FILE TASK_NUMBER OUTFILE" >&2
  echo "       sdd-brief --check PLAN_FILE BRIEF_FILE..." >&2
  exit 2
}

# section FILE TITLE — body of "## TITLE" (heading line excluded), or empty.
section() {
  awk -v title="$2" '
    /^```/ { infence = !infence }
    !infence && /^## / {
      insec = (substr($0, 4) == title)
      next
    }
    !infence && insec && /^# / { insec = 0 }
    insec { print }
  ' "$1"
}

# task FILE N — the "Task N" heading and its body.
task() {
  awk -v n="$2" '
    /^```/ { infence = !infence }
    !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ {
      intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
    }
    intask { print }
  ' "$1"
}

# brief_section BRIEF TITLE — body of the brief's copy, which is headed
# "## TITLE (binding, verbatim from the plan)".
brief_section() {
  section "$1" "$2 (binding, verbatim from the plan)"
}

write_brief() {
  local plan=$1 n=$2 out=$3
  [ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
  local gc
  gc=$(section "$plan" "$BINDING_REQUIRED")
  [ -n "$gc" ] || { echo "plan has no '## $BINDING_REQUIRED' section: $plan" >&2; exit 3; }
  local body
  body=$(task "$plan" "$n")
  [ -n "$body" ] || { echo "task $n not found in $plan (no heading matching 'Task $n')" >&2; exit 3; }

  local head
  head=$(git -C "$(dirname "$plan")" rev-parse --short=12 HEAD 2>/dev/null || echo unknown)
  mkdir -p "$(dirname "$out")"
  {
    echo "# Brief: Task $n — $(basename "$plan" .md)"
    echo
    echo "> Generated by scripts/sdd-brief from \`$plan\` at $head. Everything in this"
    echo "> file binds the task. The sections marked verbatim are copied from the plan"
    echo "> unchanged; the task text follows. The reviewer reads this same file."
    echo
    echo "## $BINDING_REQUIRED (binding, verbatim from the plan)"
    printf '%s\n' "$gc"
    local title body_opt
    for title in "${BINDING_OPTIONAL[@]}"; do
      body_opt=$(section "$plan" "$title")
      if [ -n "$body_opt" ]; then
        echo "## $title (binding, verbatim from the plan)"
        printf '%s\n' "$body_opt"
      fi
    done
    echo "## Task $n"
    echo
    printf '%s\n' "$body"
  } > "$out"
  echo "wrote $out: $(wc -l < "$out" | tr -d ' ') lines"
}

check_briefs() {
  local plan=$1; shift
  [ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
  local rc=0 brief title want have
  for brief in "$@"; do
    [ -f "$brief" ] || { echo "MISSING $brief"; rc=1; continue; }
    for title in "$BINDING_REQUIRED" "${BINDING_OPTIONAL[@]}"; do
      want=$(section "$plan" "$title")
      [ -n "$want" ] || continue
      have=$(brief_section "$brief" "$title")
      if [ "$want" != "$have" ]; then
        echo "STALE $brief: '$title' differs from the plan (regenerate)"
        rc=1
      fi
    done
  done
  [ $rc -eq 0 ] && echo "sdd-brief: $# brief(s) carry the plan's binding sections verbatim"
  return $rc
}

if [ "${1:-}" = "--check" ]; then
  shift
  [ $# -ge 2 ] || usage
  check_briefs "$@"
else
  [ $# -eq 3 ] || usage
  write_brief "$1" "$2" "$3"
fi
